# ---- Required ----
# Session-cookie signing secret. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
LEETSOLV_SECRET_KEY=

# GitHub OAuth app (https://github.com/settings/developers).
# Authorization callback URL must be: <LEETSOLV_BASE_URL>/api/auth/callback
LEETSOLV_GITHUB_CLIENT_ID=
LEETSOLV_GITHUB_CLIENT_SECRET=

# The single owner's GitHub *numeric* id (not the username):
#   https://api.github.com/users/<your-username>  ->  "id"
LEETSOLV_OWNER_GITHUB_ID=

# Public origin of the app (e.g. https://<app>.up.railway.app).
# Used for the OAuth redirect URI and post-login redirect.
LEETSOLV_BASE_URL=

# ---- Optional (defaults shown) ----
# SQLite file. Point this at the persistent volume in production.
LEETSOLV_DATABASE_URL=sqlite:////data/leetsolv.db

# Built frontend dir for same-origin serving. The Docker image sets this.
LEETSOLV_DIST_DIR=/app/frontend/dist

# Comma-separated CORS origins; only needed when the frontend and API are
# split across origins (in production they share one origin).
LEETSOLV_CORS_ORIGINS=
